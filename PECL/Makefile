.PHONY: clean All

All:
	@echo "----------Building project:[ PECLSanzPalomarMiguel - Debug ]----------"
	@cd "PECL" && "$(MAKE)" -f  "PECLSanzPalomarMiguel.mk"
clean:
	@echo "----------Cleaning project:[ PECLSanzPalomarMiguel - Debug ]----------"
	@cd "PECL" && "$(MAKE)" -f  "PECLSanzPalomarMiguel.mk" clean
